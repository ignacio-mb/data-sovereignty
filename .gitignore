# Secrets — never commit
.env
.dlt/secrets.toml
**/.dlt/secrets.toml

# Which instance this checkout deploys to. Not secret, but account-specific,
# and this repository is public.
.deploy.env

# Terraform. State can contain resource attributes; tfvars holds account ids.
# .terraform.lock.hcl is deliberately NOT here — it pins provider checksums.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan

# Local dlt / warehouse artifacts
*.duckdb
*.duckdb.wal

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/

# Runtime state (rebuildable)
airflow/logs/
quality/gx_output/
.scratch/

# Claude Code local state — .claude/skills/ IS tracked
.claude/scheduled_tasks.lock
.claude/settings.local.json

# OS
.DS_Store

# Local run logs from interactive work
.ingest.log
.build.log
.ingest2.log
.dagtest.log
