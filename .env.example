# Data Sovereignty stack configuration.
#
# `make env` copies this to .env (never overwrites) and generates the Airflow
# secrets. Fill in the values marked REQUIRED before `make up`.
#
# .env is git-ignored. Never commit real values, never echo them in logs.

# ─── Required secrets ────────────────────────────────────────────────────────

# Pylon admin API key (Bearer token for https://api.usepylon.com).
PYLON_API_KEY=

# Metabase Enterprise production license token. Without it the instance boots
# but behaves like OSS: transforms, git-sync and Library stay locked.
MB_PREMIUM_EMBEDDING_TOKEN=

# Metabase setup-wizard admin. The password must satisfy MB_PASSWORD_COMPLEXITY.
MB_ADMIN_EMAIL=ignacio@metabase.com
MB_ADMIN_PASSWORD=

# Written by scripts/bootstrap_metabase.sh — leave blank on a fresh checkout.
MB_API_KEY=

# ─── Warehouse ───────────────────────────────────────────────────────────────

WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse

# dlt destination credentials. These are the HOST-facing values (running the
# CLI from your laptop). Containers get warehouse-db:5432 injected by compose,
# so you never have to think about which side you are on.
DESTINATION__CLICKHOUSE__CREDENTIALS__HOST=localhost
DESTINATION__CLICKHOUSE__CREDENTIALS__PORT=9001
DESTINATION__CLICKHOUSE__CREDENTIALS__HTTP_PORT=8124
DESTINATION__CLICKHOUSE__CREDENTIALS__SECURE=0
DESTINATION__CLICKHOUSE__CREDENTIALS__USERNAME=warehouse
DESTINATION__CLICKHOUSE__CREDENTIALS__PASSWORD=warehouse
DESTINATION__CLICKHOUSE__CREDENTIALS__DATABASE=raw_pylon

# ─── Metabase application database ───────────────────────────────────────────

METABASE_APP_DB=metabaseapp
METABASE_APP_USER=metabase
METABASE_APP_PASSWORD=metabase

# ─── Airflow ─────────────────────────────────────────────────────────────────

AIRFLOW_DB=airflow
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# Generated by `make env` (scripts/gen_secrets.sh). Rotating them invalidates
# existing Airflow connections/variables encrypted with the old Fernet key.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Host UID that owns the bind-mounted airflow/logs directory.
AIRFLOW_UID=50000

# ─── Images ──────────────────────────────────────────────────────────────────

METABASE_IMAGE=metabase/metabase-enterprise:v1.63.1.6
AIRFLOW_BASE_IMAGE=apache/airflow:3.3.0-python3.12

# ─── Host ports ──────────────────────────────────────────────────────────────
# Chosen to not collide with the metabase-demo stack (3000/5433).

METABASE_HOST_PORT=3100
AIRFLOW_HOST_PORT=8080
WAREHOUSE_HTTP_PORT=8124
WAREHOUSE_NATIVE_PORT=9001
DATADOCS_HOST_PORT=8081

# ─── Metabase CLI (mb / mbx) ─────────────────────────────────────────────────

MB_URL=http://localhost:3100
# Quote any value containing a space: scripts source this file with `set -a`,
# and bash would otherwise read the second word as a command.
MB_SITE_NAME="Data Sovereignty"
# Headless credential storage — no OS keychain prompts in containers or CI.
MB_CLI_DISABLE_KEYRING=1

# ─── Data quality ────────────────────────────────────────────────────────────

# Raw freshness SLO: fail if max(issues.updated_at) is older than this.
GX_FRESHNESS_HOURS=24

# ─── Metabase content git-sync (optional, deferred) ──────────────────────────
# Leave blank and `mbx gitsync` is a clean no-op. Fill in to version Metabase
# content in a dedicated repo (recommended name: data-sovereignty-metabase-content).

MB_GIT_SYNC_URL=
MB_GIT_SYNC_BRANCH=main
MB_GIT_SYNC_PAT=

# ─── Escape hatches (leave commented unless you know you need them) ──────────
# Only for a STAGING Metabase license token. With a production token the
# instance runs in normal mode and these must stay unset.
# MB_RUN_MODE=e2e
# METASTORE_DEV_SERVER_URL=https://token-check.staging.metabase.com
